type: custom:horizon-card
card_mod:
  style: |
    :host { --bubble-border-radius: 16px !important; }

    {% set lux = states('sensor.st_00176926_illuminance') | float(0) %}
    {% set top_color = '#05060A' %}
    {% if lux >= 100000 %}{% set top_color = '#FFFFFF' %}
    {% elif lux >= 60000 %}{% set top_color = '#FFF2CC' %}
    {% elif lux >= 40000 %}{% set top_color = '#FFB36A' %}
    {% elif lux >= 20000 %}{% set top_color = '#FFD59A' %}
    {% elif lux >= 10000 %}{% set top_color = '#E9F6FF' %}
    {% elif lux >= 5000 %}{% set top_color = '#7EC8FF' %}
    {% elif lux >= 2500 %}{% set top_color = '#9FD6C8' %}
    {% elif lux >= 1000 %}{% set top_color = '#B8D9F2' %}
    {% elif lux >= 400 %}{% set top_color = '#78AEDD' %}
    {% elif lux >= 150 %}{% set top_color = '#4C7FB8' %}
    {% elif lux >= 60 %}{% set top_color = '#2A4C7A' %}
    {% elif lux >= 20 %}{% set top_color = '#1A2E5A' %}
    {% elif lux >= 5 %}{% set top_color = '#121A3A' %}
    {% elif lux >= 1 %}{% set top_color = '#0A1026' %}
    {% endif %}

    {% set is_night = is_state('sun.sun','below_horizon') %}
    {% set has_sun = not is_night %}
    {% set sun_state = states('sun.sun') %}
    {% set now_ts = as_timestamp(now()) %}
    {% set next_rise = as_timestamp(state_attr('sun.sun','next_rising'), 0) %}
    {% set next_set  = as_timestamp(state_attr('sun.sun','next_setting'), 0) %}
    {% set elev = states('sensor.sun_solar_elevation') | float(-90) %}

    {% if sun_state == 'above_horizon' %}
      {% set rise_ts = next_rise %}
      {% if next_rise > now_ts %}{% set rise_ts = next_rise - 86400 %}{% endif %}
      {% set set_ts = next_set %}
      {% set denom = (set_ts - rise_ts) if (set_ts - rise_ts) > 0 else 1 %}
      {% set progress = (now_ts - rise_ts) / denom %}
      {% set progress = 0 if progress < 0 else (1 if progress > 1 else progress) %}
      {% set sun_x = (10 + (80 * progress)) %}
      {% set e = elev if elev > 0 else 0 %}
      {% set e = 70 if e > 70 else e %}
      {% set sun_y = (85 - (80 * (e / 70))) %}
    {% else %}
      {% set sun_x = 50 %}
      {% set sun_y = 120 %}
    {% endif %}

    /* ----------------------------
       CARD BASE
       ---------------------------- */
    ha-card {
      position: relative;
      background: transparent !important;
      box-shadow: 0px 0px 10px 0px rgba(0,0,0,0.5) !important;
      overflow: hidden;
      transform-origin: top;
      border-top-left-radius: 16px !important;
      border-top-right-radius: 16px !important;
      border-bottom-left-radius: 0px !important;
      border-bottom-right-radius: 0px !important;
    }

    ha-card::before {
          content: "";
          position: absolute;
          inset: -25%;
          pointer-events: none;
          z-index: 0;
          filter: blur(2px);
          
          /* ANIMATION CALL */
          animation: sun-pulse 6s ease-in-out infinite;

          {% set sun_outer = (top_color ~ '33') if has_sun else 'rgba(0,0,0,0)' %}
          {% set sun_mid   = (top_color ~ '66') if has_sun else 'rgba(0,0,0,0)' %}
          {% set sun_core  = (top_color ~ 'CC') if has_sun else 'rgba(0,0,0,0)' %}

          background:
            /* 🌞 OUTER ATMOSPHERE - Reduced from 20%/50% to 10%/30% */
            radial-gradient(
              circle at {{ sun_x }}% {{ sun_y }}%, 
              {{ sun_outer }} 10%, 
              transparent 20%
            ),
            /* ☀️ MID AURA - Reduced from 35% to 15% */
            radial-gradient(
              circle at {{ sun_x }}% {{ sun_y }}%, 
              {{ sun_mid }} 0%, 
              transparent 25%
            ),
            /* 🔆 INNER CORE - Sharpened to 4% */
            radial-gradient(
              circle at {{ sun_x }}% {{ sun_y }}%, 
              {{ sun_core }} 5%, 
              transparent 0%
            );

        }/* ----------------------------
           ANIMATION & Z-INDEX
           ---------------------------- */
        @keyframes sun-pulse {
          0%, 100% { opacity: 1; transform: scale(1.25); }
          50% { opacity: 1; transform: scale(1.05); }
        }

    ha-card > * {
      position: relative;
      z-index: 2;
    }
        ha-card::after {
          content: "";
          position: absolute;
          inset: 0;
          pointer-events: none;
          z-index: 1;
          opacity: 0.85;

          {% set now_ts = as_timestamp(now()) %}
          {% set rise_ts = as_timestamp(state_attr('sun.sun','next_rising'), 0) %}
          {% set set_ts  = as_timestamp(state_attr('sun.sun','next_setting'), 0) %}

          {# make rise_ts be today's sunrise #}
          {% if rise_ts > now_ts %}{% set rise_ts = rise_ts - 86400 %}{% endif %}

          {# ensure set_ts is after rise_ts #}
          {% if set_ts < rise_ts %}{% set set_ts = set_ts + 86400 %}{% endif %}

          {# start of local day #}
          {% set day_start = as_timestamp(now().replace(hour=0, minute=0, second=0, microsecond=0)) %}

          {# map sunrise/sunset onto 0-100% of day #}
          {% set sunrise_pct = ((rise_ts - day_start) / 86400 * 100) %}
          {% set sunset_pct  = ((set_ts  - day_start) / 86400 * 100) %}

          {# solar noon = midpoint between sunrise and sunset #}
          {% set noon_ts = rise_ts + ((set_ts - rise_ts) / 2) %}
          {% set noon_pct = ((noon_ts - day_start) / 86400 * 100) %}

          background:

          /* 🕛 SOLAR NOON (dominant) */
          linear-gradient(
            to bottom,
            {{ top_color ~ 'FF' }} 0%,
            {{ top_color ~ 'FF' }} 0%,
            {{ top_color ~ 'FF' }} 0%,
            {{ top_color ~ 'FF' }} 0%
          )
          calc({{ noon_pct }}% - 2px) / 1px 45% no-repeat;

        }
