card_mod:
  style: >
    ha-card {
      position: relative;
      overflow: hidden;
      border-radius: 16px;
    }

    /* ===============================
       GLASS BLUR LAYER
       =============================== */
    ha-card::before {
      content: "";
      position: absolute;
      inset: 0;
      z-index: 0;

      /* This is critical */
      backdrop-filter: blur(14px) saturate(140%);
      -webkit-backdrop-filter: blur(14px) saturate(140%);

      /* Must NOT be fully transparent */
      background: rgba(0, 0, 0, 0.25);

      pointer-events: none;
    }

    /* Keep all real content ABOVE blur */ ha-card > * {
      position: relative;
      z-index: 1;
    }  /* ----------------------------
       TEMP -> BOTTOM COLOR
       ---------------------------- */
    {% set temp = states('sensor.st_00176926_air_temperature') | float(0) %} {%
    set bottom_color = '#D8C8B8' %} {% if temp >= 105 %}
      {% set bottom_color = '#58141D' %}
    {% elif temp >= 100 %}
      {% set bottom_color = '#B32821' %}
    {% elif temp >= 95 %}
      {% set bottom_color = '#C73E1D' %}
    {% elif temp >= 90 %}
      {% set bottom_color = '#E35D27' %}
    {% elif temp >= 85 %}
      {% set bottom_color = '#FF7518' %}
    {% elif temp >= 80 %}
      {% set bottom_color = '#FF9C00' %}
    {% elif temp >= 75 %}
      {% set bottom_color = '#FFD200' %}
    {% elif temp >= 70 %}
      {% set bottom_color = '#FFEC00' %}
    {% elif temp >= 65 %}
      {% set bottom_color = '#A9C94C' %}
    {% elif temp >= 60 %}
      {% set bottom_color = '#7DBB48' %}
    {% elif temp >= 55 %}
      {% set bottom_color = '#6DB04A' %}
    {% elif temp >= 50 %}
      {% set bottom_color = '#4C9F38' %}
    {% elif temp >= 45 %}
      {% set bottom_color = '#1D9D73' %}
    {% elif temp >= 40 %}
      {% set bottom_color = '#00A19A' %}
    {% elif temp >= 35 %}
      {% set bottom_color = '#6CC6CE' %}
    {% elif temp >= 30 %}
      {% set bottom_color = '#9ED4F0' %}
    {% elif temp >= 25 %}
      {% set bottom_color = '#2C5AA0' %}
    {% elif temp >= 20 %}
      {% set bottom_color = '#1C3D7A' %}
    {% elif temp >= 15 %}
      {% set bottom_color = '#5C4699' %}
    {% elif temp >= 10 %}
      {% set bottom_color = '#7E58A0' %}
    {% elif temp >= 5 %}
      {% set bottom_color = '#856A67' %}
    {% elif temp >= 0 %}
      {% set bottom_color = '#A6A1A1' %}
    {% elif temp >= -5 %}
      {% set bottom_color = '#BFB6AF' %}
    {% endif %}


    /* ----------------------------
       CARD BASE
       ---------------------------- */
        ha-card {
          position: relative;
          background: transparent !important;
          box-shadow: 0px 0px 10px 0px rgba(0,0,0,0.5) !important;
          border-radius: 16px !important;
          overflow: hidden;
          transform-origin: top;
          transform: scale(0.95);
          transform-origin: top center;
          margin: 0 !important;
    } /* ONE unified glow layer */ ha-card::before {
      content: "";
      position: absolute;
      inset: -25%;
      pointer-events: none;
      z-index: 0;

      background:

        /* 🌡️ TEMP GLOW (BOTTOM) — this was upside-down in your version */
        radial-gradient(
          circle at 50% 0%,
          {{ bottom_color ~ '88' }} 50%,
          rgba(0,0,0,0) 100%
        );

      opacity: 1;
      filter: blur(18px);

        /* ----------------------------
           WIND DIRECTION (degrees) -> glow position
           ---------------------------- */
        {% set deg = states('sensor.st_00176926_wind_direction') | float(0) %}
        {% set rad = (deg - 90) * 3.14159265 / 180 %} {% set wind_x = 50 + (45 *
        (rad | cos)) %} {% set wind_y = 50 + (45 * (rad | sin)) %}

        /* NORTH = RED | SOUTH = BLUE (smooth cosine) */ {% set north_strength =
        ((deg * 3.14159265 / 180) | cos + 1) / 2 %} {% set red  = (255 *
        north_strength) | int %} {% set blue = (255 * (1 - north_strength)) |
        int %} {% set wind_rgba = 'rgba(' ~ red ~ ', 1, ' ~ blue ~ ', 1)' %}

    }  /* -----------------------------
       WIND BORDER GLOW (MASKED)
       ----------------------------- */
    ha-card::after {
      content: "";
      position: absolute;
      inset: -1px;
      pointer-events: none;
      z-index: 2;
      border-radius: 16px;
      padding: 5px;

      background:
        radial-gradient(
          circle at {{ wind_x }}% {{ wind_y }}%,
          {{ wind_rgba }} 10%,
          rgba(0,0,0,0) 25%
        );

      -webkit-mask:
        linear-gradient(#000 0 0) content-box,
        linear-gradient(#000 0 0);
      -webkit-mask-composite: xor;

      mask:
        linear-gradient(#000 0 0) content-box,
        linear-gradient(#000 0 0);
      mask-composite: exclude;
    }
